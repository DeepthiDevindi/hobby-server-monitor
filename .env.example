# Copy this file to .env and fill in real values. Commit .env.
#
# This list is a *starting point* covering the categories the brief calls
# out explicitly (Google OAuth, bootstrap admin, DB paths, collector
# interval, LXD access). Add/rename variables as your implementation needs —
# just keep this file in sync so a reviewer can configure a fresh machine
# from it alone.

# --- Google OAuth 2.0 ---------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Session / auth -------------------------------------------------------
# Secret used to sign session cookies / tokens. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=

# --- Bootstrap admin -------------------------------------------------------
# If set, this email becomes Admin on first sign-in instead of "first user
# to sign in wins". Document your chosen bootstrap strategy in README.md.
BOOTSTRAP_ADMIN_EMAIL=

# --- Storage ---------------------------------------------------------------
SQLITE_DB_PATH=./data/app.db
TINYFLUX_DB_PATH=./data/metrics.tinyflux

# --- LXD ---------------------------------------------------------------
# e.g. unix:///var/snap/lxd/common/lxd/unix.socket, or an HTTPS remote.
LXD_ENDPOINT=unix:///var/snap/lxd/common/lxd/unix.socket
LXD_VERIFY_CERT=true

# --- Background collector ---------------------------------------------------
COLLECTOR_POLL_INTERVAL_SECONDS=10
# How long raw samples are retained before being downsampled/pruned.
METRICS_RETENTION_DAYS=30

# --- Web servers -------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000

DASHBOARD_PORT=4321
