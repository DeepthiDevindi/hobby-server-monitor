# Copy to .env (dev) or /etc/hobby-server-monitor/env (systemd). Never commit the real file.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# >= 32 random chars. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# This exact verified Google address is always admin. Everyone else starts with no access.
BOOTSTRAP_ADMIN_EMAIL=
# false ONLY for http://localhost development. Must be true behind HTTPS.
COOKIE_SECURE=false

# ---- optional (defaults shown) ----
# Exact browser origin; used for the OAuth redirect URI, CSRF Origin check and WebSocket Origin check.
# PUBLIC_ORIGIN=http://localhost:8000
# SESSION_HOURS=8
# METRICS_INTERVAL=4            # seconds, clamped to 3..5
# TERMINAL_IDLE_SECONDS=900
# TERMINAL_MAX_PER_USER=2
# TERMINAL_MAX_TOTAL=8
# MAX_MEMORY_MIB=4096
# DATABASE_PATH=./data/monitor.db
# LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
