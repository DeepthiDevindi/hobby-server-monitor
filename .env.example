# Copy to .env (development) or /etc/hobby-server-monitor/env (systemd) and fill in.
# NEVER commit the real file (.env is in .gitignore). Every variable is listed here.

# --- Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an "Authorised redirect URI" of the OAuth client exactly.
# Its origin (scheme://host:port) is also the browser origin used for the
# CSRF and WebSocket Origin checks.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Session / auth ---
# >= 32 random chars: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# false ONLY for http://localhost development; true behind HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60

# --- Bootstrap admin ---
# This exact verified Google address is invited as admin by init_db and is
# always admin. Everyone else must be invited by an admin.
BOOTSTRAP_ADMIN_EMAIL=

# --- Storage (defaults shown; relative paths are relative to the repo root) ---
# Leave commented for systemd: the units set /var/lib/hobby-server-monitor/...,
# and values in an EnvironmentFile would override the unit's own settings.
# SQLITE_DB_PATH=./data/app.db
# Directory holding the TinyFlux segment files (raw/, 5m/, 1h/) and latest.json.
# TINYFLUX_DB_PATH=./data/metrics

# --- LXD ---
# unix:///path/to/socket (the terminal needs the unix socket) or an https:// remote.
LXD_ENDPOINT=unix:///var/snap/lxd/common/lxd/unix.socket
LXD_VERIFY_CERT=true

# --- Background collector ---
# (comments stay on their own lines: systemd's EnvironmentFile has no inline comments)
COLLECTOR_POLL_INTERVAL_SECONDS=10
# how long 10 s samples / 5-minute rollups / 1-hour rollups are kept
RAW_RETENTION_HOURS=6
ROLLUP_RETENTION_DAYS=7
METRICS_RETENTION_DAYS=30

# --- Web server (python -m hsm.web) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Built Astro dashboard served by the backend (no Node at runtime); default shown.
# DASHBOARD_DIST=./dashboard/dist

# --- Terminal / exec limits ---
TERMINAL_IDLE_SECONDS=900
TERMINAL_MAX_PER_USER=2
TERMINAL_MAX_TOTAL=8
EXEC_TIMEOUT_SECONDS=30
